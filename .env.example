# ---------------------------------------------------------------------------
# Shared config for ALL services (Node webhook, cron jobs, Python print server)
# Copy to .env and fill in your values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Twilio ---
# Account SID from https://console.twilio.com (used as the username to download
# MMS image attachments; required to print texted photos)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Auth token from https://console.twilio.com (validates webhooks + media downloads)
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# Your Twilio number in E.164 format (informational; not required by the server)
TWILIO_PHONE_NUMBER=+15551234567
# Comma-separated E.164 numbers allowed to print
ALLOWED_NUMBERS=+15559876543

# --- SMS webhook server (src/server.js) ---
PORT=3000

# --- Printer endpoint (shared by the webhook + the cron jobs) ---
# Keep 127.0.0.1 (not localhost): Node 18's fetch may resolve localhost to
# IPv6 ::1, which the IPv4-only Flask server doesn't listen on.
PRINTER_URL=http://127.0.0.1:5000/print

# --- Print server (printer/print_server.py) ---
# Find your printer's IDs with `lsusb` (idVendor:idProduct), prefix each with 0x.
PRINTER_VENDOR_ID=0x0483
PRINTER_PRODUCT_ID=0x5743
PRINTER_PORT=5000
# Max width (in dots) that texted images are scaled to. 80mm printers are 576;
# 58mm printers are typically 384.
PRINTER_IMAGE_WIDTH=576

# --- Weather job (weather.js) ---
# Example: Denver, CO. Set to your own location.
WEATHER_LAT=39.7392
WEATHER_LON=-104.9903
WEATHER_TIMEZONE=America/Denver

# --- Calendar job (calendar.js) ---
# OAuth Desktop-app client from Google Auth Platform > Clients (see README).
# NOTE: Google shows the client secret only once, at creation — copy it then.
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# Refresh-token file written by `node authorize.js` (gitignored; scp to the Pi)
#GOOGLE_OAUTH_TOKEN=./google-token.json
# Comma-separated calendarId:Label pairs. The calendar ID is usually the
# account's gmail address; the label is the short tag printed next to each event.
CALENDAR_IDS=taylor@gmail.com:T,peter@gmail.com:P
# Optional; falls back to WEATHER_TIMEZONE
#CALENDAR_TIMEZONE=America/Denver

# --- Poem job (poem.js) ---
# Free PoetryDB API (no key/account required). Override only if self-hosting.
#POEM_API_BASE=https://poetrydb.org
# Max poem length in lines (keeps receipts short). Default 12.
#POEM_MAX_LINES=12

# --- Gameday job (gameday.js) ---
# Prints a receipt for any watched team playing today or tomorrow, plus the rest
# of the weekend when it runs on a Friday. Silent when nobody plays.
# ESPN's public NFL API (no key/account required). Override only for testing.
#NFL_API_BASE=https://site.api.espn.com
# Comma-separated ESPN team abbreviations to watch. Default den,buf.
#NFL_TEAMS=den,buf
# Pretend it's this date (YYYY-MM-DD) instead of today, so you can test the
# receipt without waiting for a game day. Leave unset in production.
#NFL_DATE=2026-12-18
# Timezone is shared with the weather job (WEATHER_TIMEZONE, default America/Denver).

# --- Reminders (reminders.js, run every minute by cron) ---
# Text "remind me at 7pm to take out the trash" and it prints at 7pm instead of
# now. Timezone is shared with the calendar/weather jobs (CALENDAR_TIMEZONE /
# WEATHER_TIMEZONE, default America/Denver).
# When a reminder names a day but no time ("in 2 days", "tomorrow"), fire at this
# hour (24h, local). Default 8 (8:00 AM).
#REMINDER_DEFAULT_HOUR=8
# Where pending reminders are stored. Default: reminders.json in the repo root.
#REMINDERS_FILE=./reminders.json
